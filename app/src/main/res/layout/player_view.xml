<?xml version="1.0" encoding="utf-8"?>
<!--
    surface_type="texture_view" : le SurfaceView par defaut d'ExoPlayer gere sa
    propre surface de composition, separee du reste de l'UI — mal integre dans
    un AndroidView Compose (ecran noir/fige, notamment sur des transitions
    apercu -> plein ecran). TextureView est le mode recommande dans ce cas.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false" />
